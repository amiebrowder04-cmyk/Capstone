        <calculation class='tableau' formula='IF [Parameters].[Parameter 0127596269096961] = &quot;Nonprofits per 1,000&quot; THEN&#13;&#10;    STR(ROUND([Nonprofits_Per_1000], 1))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0127596269096961] = &quot;People per Nonprofit&quot; THEN&#13;&#10;    STR(ROUND([People_Per_Nonprofit], 0))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0127596269096961] = &quot;None&quot; THEN&#13;&#10;    &quot;&quot;&#13;&#10;&#13;&#10;END' />
